# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/blood_donation_db

# Security & Authentication
JWT_SECRET=emergency_blood_matching_secret_key_change_in_production_2026
JWT_EXPIRE=30d
ADMIN_INVITE_KEY=admin_emergency_2026

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Email Service (SMTP)
# If left blank, local Ethereal test inbox or simulated console log is used automatically
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=emergency@bloodnetwork.org
