{
  "info": {
    "name": "Blood Donation & Emergency Matching API",
    "_postman_id": "c1f7b8d4-5a21-4f1a-b62e-33758296a849",
    "description": "Comprehensive Postman test collection for LifeFlow Emergency Blood Donation and Matching System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login as Donor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul.verma@example.com\",\n  \"password\": \"donor123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login as Requester",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dr.sharma@citycare.org\",\n  \"password\": \"requester123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bloodnetwork.org\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register New Donor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Voluntary Donor\",\n  \"email\": \"testdonor@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+91 99887 76655\",\n  \"role\": \"donor\",\n  \"bloodGroup\": \"O+\",\n  \"coordinates\": [77.60, 12.97],\n  \"address\": {\n    \"city\": \"Bangalore\",\n    \"state\": \"Karnataka\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Donor Operations",
      "item": [
        {
          "name": "Get My Donor Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/donors/me",
              "host": ["{{baseUrl}}"],
              "path": ["donors", "me"]
            }
          }
        },
        {
          "name": "Toggle Availability",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availabilityStatus\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/donors/availability",
              "host": ["{{baseUrl}}"],
              "path": ["donors", "availability"]
            }
          }
        },
        {
          "name": "Get Relevant Nearby Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/donors/requests?allBloodGroups=false",
              "host": ["{{baseUrl}}"],
              "path": ["donors", "requests"],
              "query": [{ "key": "allBloodGroups", "value": "false" }]
            }
          }
        },
        {
          "name": "Get Donation History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/donors/history",
              "host": ["{{baseUrl}}"],
              "path": ["donors", "history"]
            }
          }
        },
        {
          "name": "Search Nearby Donors (Geospatial 2dsphere)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/donors/nearby?bloodGroup=O%2B&lat=12.9716&lng=77.5946&radiusKm=40",
              "host": ["{{baseUrl}}"],
              "path": ["donors", "nearby"],
              "query": [
                { "key": "bloodGroup", "value": "O+" },
                { "key": "lat", "value": "12.9716" },
                { "key": "lng", "value": "77.5946" },
                { "key": "radiusKm", "value": "40" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Blood Requests",
      "item": [
        {
          "name": "Create Emergency Blood Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientName\": \"Emergency Trauma ICU\",\n  \"bloodGroup\": \"O+\",\n  \"unitsRequested\": 3,\n  \"hospitalName\": \"Manipal Hospital Old Airport Rd\",\n  \"hospitalAddress\": \"98 HAL Old Airport Rd, Bangalore\",\n  \"hospitalPhone\": \"+91 80 2502 4444\",\n  \"coordinates\": [77.6514, 12.9592],\n  \"urgency\": \"critical\",\n  \"requiredBy\": \"2026-10-25T18:00:00.000Z\",\n  \"description\": \"Immediate whole blood required for emergency surgery\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests",
              "host": ["{{baseUrl}}"],
              "path": ["requests"]
            }
          }
        },
        {
          "name": "Get All Blood Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/requests?status=open",
              "host": ["{{baseUrl}}"],
              "path": ["requests"],
              "query": [{ "key": "status", "value": "open" }]
            }
          }
        },
        {
          "name": "Update Request Status (Lifecycle Transition)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"coordination_in_progress\",\n  \"closureNotes\": \"Donor on the way to hospital\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["requests", ":id", "status"]
            }
          }
        },
        {
          "name": "Cancel Blood Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Reserves fulfilled on-site\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests/:id/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["requests", ":id", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Administration",
      "item": [
        {
          "name": "Get Admin Dashboard Aggregations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "dashboard"]
            }
          }
        },
        {
          "name": "Get Donor Verification Queue",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/donors",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "donors"]
            }
          }
        },
        {
          "name": "Verify Donor Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verificationStatus\": \"verified\",\n  \"medicalReviewNotes\": \"Donor meets all hemoglobin and clinical screening criteria\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/donors/:id/verify",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "donors", ":id", "verify"]
            }
          }
        },
        {
          "name": "View Audit Trail Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "audit-logs"]
            }
          }
        }
      ]
    }
  ]
}
